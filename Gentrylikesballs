<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1a0533">
<title>Weird Cat Grand Prix</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
:root{--track:#2d4a1e;--road:#444;--line:#fff;--sky:#87CEEB;--grass:#3a7d1e}
body{background:#1a0533;font-family:'Nunito',sans-serif;overflow:hidden;width:100vw;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center}

/* SCREENS */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10}
.screen.hidden{display:none}

/* TITLE SCREEN */
#title-screen{background:linear-gradient(180deg,#1a0533 0%,#2d0a5e 100%)}
.title-stars{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.star{position:absolute;width:3px;height:3px;background:white;border-radius:50%;animation:twinkle 2s infinite}
@keyframes twinkle{0%,100%{opacity:1}50%{opacity:0.2}}
.game-title{font-family:'Fredoka One',cursive;font-size:42px;color:#FFD700;text-align:center;line-height:1.1;text-shadow:4px 4px 0 #8B4513,0 0 30px rgba(255,215,0,0.5);margin-bottom:8px}
.game-subtitle{font-size:14px;color:#ff9de2;margin-bottom:30px;letter-spacing:0.1em}
.cat-parade{display:flex;gap:16px;margin-bottom:36px;font-size:48px}
.cat-parade span{animation:bounce 0.6s infinite alternate}
.cat-parade span:nth-child(2){animation-delay:0.15s}
.cat-parade span:nth-child(3){animation-delay:0.3s}
.cat-parade span:nth-child(4){animation-delay:0.45s}
@keyframes bounce{from{transform:translateY(0) rotate(-5deg)}to{transform:translateY(-12px) rotate(5deg)}}
.big-btn{font-family:'Fredoka One',cursive;font-size:24px;padding:16px 48px;border-radius:50px;border:none;cursor:pointer;transition:transform 0.1s;margin-bottom:12px;width:260px}
.big-btn:active{transform:scale(0.95)}
.btn-race{background:linear-gradient(135deg,#ff6b35,#f7c59f);color:#1a0533;box-shadow:0 6px 0 #c0392b}
.btn-race:active{box-shadow:0 2px 0 #c0392b;transform:translateY(4px)}
.btn-secondary{background:linear-gradient(135deg,#a29bfe,#6c5ce7);color:white;font-size:16px;padding:12px 32px;box-shadow:0 4px 0 #4a3ab5}
.btn-secondary:active{box-shadow:0 1px 0 #4a3ab5;transform:translateY(3px)}

/* CAR SELECT */
#select-screen{background:linear-gradient(180deg,#0f3460 0%,#16213e 100%)}
.select-title{font-family:'Fredoka One',cursive;font-size:32px;color:#FFD700;margin-bottom:6px}
.select-sub{font-size:13px;color:#aaa;margin-bottom:24px}
.cat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;width:320px;margin-bottom:24px}
.cat-option{background:rgba(255,255,255,0.07);border:3px solid rgba(255,255,255,0.15);border-radius:20px;padding:16px 12px;cursor:pointer;transition:all 0.2s;text-align:center}
.cat-option.selected{border-color:#FFD700;background:rgba(255,215,0,0.15)}
.cat-emoji{font-size:44px;display:block;margin-bottom:6px}
.cat-name{font-family:'Fredoka One',cursive;font-size:16px;color:white;margin-bottom:2px}
.cat-stat{font-size:11px;color:#aaa}
.stat-bar{height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin-top:4px;overflow:hidden}
.stat-fill{height:100%;border-radius:2px;background:#FFD700}

/* GAME CANVAS */
#game-screen{background:#1a0533}
canvas{display:block;touch-action:none}
#hud{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-start;padding:12px 16px;pointer-events:none;z-index:5}
.hud-box{background:rgba(0,0,0,0.55);border-radius:12px;padding:6px 12px;backdrop-filter:blur(4px)}
.hud-label{font-size:9px;color:#aaa;letter-spacing:0.1em;text-transform:uppercase}
.hud-val{font-family:'Fredoka One',cursive;font-size:20px;color:#FFD700}
.lap-indicator{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Fredoka One',cursive;font-size:52px;color:#FFD700;text-shadow:3px 3px 0 #8B4513;opacity:0;pointer-events:none;z-index:20;transition:opacity 0.3s}
.lap-indicator.show{opacity:1}
#controls{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-end;padding:16px;z-index:5;pointer-events:none}
.ctrl-btn{width:72px;height:72px;border-radius:50%;border:3px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;pointer-events:all;user-select:none;-webkit-user-select:none;active:scale(0.9)}
.ctrl-btn:active{background:rgba(255,255,255,0.3);transform:scale(0.9)}
.ctrl-center{display:flex;flex-direction:column;align-items:center;gap:8px}
.ctrl-row{display:flex;gap:8px}
.ctrl-small{width:56px;height:56px;font-size:22px}

/* RESULTS */
#result-screen{background:linear-gradient(180deg,#1a0533,#2d0a5e)}
.podium{display:flex;align-items:flex-end;gap:8px;margin:20px 0}
.podium-place{display:flex;flex-direction:column;align-items:center}
.podium-cat{font-size:36px;margin-bottom:4px}
.podium-block{width:72px;border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;font-family:'Fredoka One',cursive;font-size:24px;color:white}
.p1-block{height:90px;background:linear-gradient(135deg,#FFD700,#FFA500)}
.p2-block{height:66px;background:linear-gradient(135deg,#C0C0C0,#A0A0A0)}
.p3-block{height:48px;background:linear-gradient(135deg,#CD7F32,#A05020)}
.result-title{font-family:'Fredoka One',cursive;font-size:36px;color:#FFD700;text-shadow:3px 3px 0 #8B4513;margin-bottom:4px}
.result-sub{font-size:14px;color:#ff9de2;margin-bottom:16px}
.your-place{font-family:'Fredoka One',cursive;font-size:22px;color:white;margin-bottom:20px}
.your-place span{color:#FFD700}
</style>
</head>
<body>

<!-- TITLE -->
<div id="title-screen" class="screen">
  <div class="title-stars" id="stars"></div>
  <div class="cat-parade">
    <span>🐱</span><span>😸</span><span>🙀</span><span>😹</span>
  </div>
  <div class="game-title">Weird Cat<br>Grand Prix</div>
  <div class="game-subtitle">🏁 the most chaotic race on earth 🏁</div>
  <button class="big-btn btn-race" onclick="showSelect()">RACE NOW</button>
  <button class="big-btn btn-secondary" onclick="showHowTo()">how to play</button>
</div>

<!-- SELECT -->
<div id="select-screen" class="screen hidden">
  <div class="select-title">Pick Your Cat</div>
  <div class="select-sub">choose wisely. they are all unhinged.</div>
  <div class="cat-grid" id="cat-grid"></div>
  <button class="big-btn btn-race" onclick="startRace()">GOOOO 🏎️</button>
  <button class="big-btn btn-secondary" style="margin-top:8px" onclick="showTitle()">back</button>
</div>

<!-- GAME -->
<div id="game-screen" class="screen hidden">
  <canvas id="raceCanvas"></canvas>
  <div id="hud">
    <div class="hud-box"><div class="hud-label">lap</div><div class="hud-val" id="hud-lap">1/3</div></div>
    <div class="hud-box"><div class="hud-label">place</div><div class="hud-val" id="hud-place">1st</div></div>
    <div class="hud-box"><div class="hud-label">speed</div><div class="hud-val" id="hud-speed">0</div></div>
  </div>
  <div class="lap-indicator" id="lap-indicator">LAP 2!</div>
  <div id="controls">
    <div class="ctrl-btn" id="btn-left" ontouchstart="keys.left=true" ontouchend="keys.left=false">◀</div>
    <div class="ctrl-center">
      <div class="ctrl-btn ctrl-small" id="btn-brake" ontouchstart="keys.brake=true" ontouchend="keys.brake=false">🛑</div>
      <div class="ctrl-btn" id="btn-gas" ontouchstart="keys.gas=true" ontouchend="keys.gas=false">🐾</div>
    </div>
    <div class="ctrl-btn" id="btn-right" ontouchstart="keys.right=true" ontouchend="keys.right=false">▶</div>
  </div>
</div>

<!-- RESULTS -->
<div id="result-screen" class="screen hidden">
  <div class="result-title">RACE OVER!</div>
  <div class="result-sub" id="result-sub"></div>
  <div class="your-place" id="your-place"></div>
  <div class="podium" id="podium"></div>
  <button class="big-btn btn-race" onclick="startRace()">RACE AGAIN</button>
  <button class="big-btn btn-secondary" style="margin-top:8px" onclick="showTitle()">main menu</button>
</div>

<script>
// CATS DATA
const CATS = [
  {name:"Chonk Racer",emoji:"😸",color:"#FF6B6B",speed:0.7,handling:0.9,desc:"fast paws, no plan",speedBar:70,handBar:90},
  {name:"Sir Fluffington",emoji:"🧐",color:"#A29BFE",speed:0.9,handling:0.6,desc:"very fast, zero chill",speedBar:90,handBar:60},
  {name:"Chaos Gremlin",emoji:"🙀",color:"#00CEC9",speed:0.8,handling:0.75,desc:"balanced & unhinged",speedBar:80,handBar:75},
  {name:"Loaf Mode",emoji:"😴",color:"#FDCB6E",speed:0.5,handling:0.95,desc:"slow but never crashes",speedBar:50,handBar:95},
];

let selectedCat = 0;
let gameLoop = null;
let keys = {gas:false,brake:false,left:false,right:false};

// TITLE STARS
function makeStars(){
  const c=document.getElementById('stars');
  for(let i=0;i<60;i++){
    const s=document.createElement('div');
    s.className='star';
    s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;animation-delay:${Math.random()*2}s;opacity:${0.3+Math.random()*0.7}`;
    c.appendChild(s);
  }
}
makeStars();

// BUILD CAT GRID
function buildGrid(){
  const g=document.getElementById('cat-grid');
  g.innerHTML='';
  CATS.forEach((cat,i)=>{
    const d=document.createElement('div');
    d.className='cat-option'+(i===selectedCat?' selected':'');
    d.innerHTML=`<span class="cat-emoji">${cat.emoji}</span>
      <div class="cat-name">${cat.name}</div>
      <div class="cat-stat">${cat.desc}</div>
      <div style="margin-top:6px"><div class="hud-label">speed</div><div class="stat-bar"><div class="stat-fill" style="width:${cat.speedBar}%"></div></div></div>
      <div style="margin-top:4px"><div class="hud-label">handling</div><div class="stat-bar"><div class="stat-fill" style="width:${cat.handBar}%;background:#ff9de2"></div></div></div>`;
    d.onclick=()=>{selectedCat=i;buildGrid();};
    g.appendChild(d);
  });
}

function showTitle(){hideAll();document.getElementById('title-screen').classList.remove('hidden');}
function showSelect(){hideAll();buildGrid();document.getElementById('select-screen').classList.remove('hidden');}
function hideAll(){document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));}
function showHowTo(){alert("🐾 HOW TO PLAY 🐾\n\n◀ ▶ = steer your cat\n🐾 = gas (go fast)\n🛑 = brake\n\nStay on the track!\nRace 3 laps to win.\nBeat the other weird cats!");}

// ===== GAME ENGINE =====
const TRACK_POINTS = [];
const NUM_TRACK_PTS = 24;
const TRACK_W = 80; // track width in world units

function generateTrack(W,H){
  TRACK_POINTS.length=0;
  const cx=W/2, cy=H/2;
  const rx=W*0.36, ry=H*0.38;
  for(let i=0;i<NUM_TRACK_PTS;i++){
    const a=(i/NUM_TRACK_PTS)*Math.PI*2;
    const wobble=0.85+0.15*Math.sin(a*3+1)*Math.cos(a*2);
    TRACK_POINTS.push({
      x: cx + Math.cos(a)*rx*wobble,
      y: cy + Math.sin(a)*ry*wobble
    });
  }
}

function getTrackPoint(t){
  const total=TRACK_POINTS.length;
  const i=Math.floor(t*total)%total;
  const j=(i+1)%total;
  const f=(t*total)%1;
  return {
    x: TRACK_POINTS[i].x*(1-f)+TRACK_POINTS[j].x*f,
    y: TRACK_POINTS[i].y*(1-f)+TRACK_POINTS[j].y*f
  };
}

function getTrackDir(t){
  const a=getTrackPoint((t+0.001)%1);
  const b=getTrackPoint((t-0.001+1)%1);
  const dx=a.x-b.x, dy=a.y-b.y;
  const len=Math.sqrt(dx*dx+dy*dy);
  return {dx:dx/len,dy:dy/len};
}

function distToTrack(x,y,t){
  const p=getTrackPoint(t);
  const dx=x-p.x, dy=y-p.y;
  return Math.sqrt(dx*dx+dy*dy);
}

// Racers
let player, cpus, lap, lapIndicatorTimer;
const PLACE_NAMES=["1st","2nd","3rd","4th"];
const QUIPS=["YOWZA!!!","PURRFECT!","MEOW YEAH!","NOT BAD FOR A CAT"];

function initRacers(W,H){
  const cat=CATS[selectedCat];
  player={
    x:TRACK_POINTS[0].x, y:TRACK_POINTS[0].y-40,
    vx:0, vy:0, angle:0,
    speed:0, maxSpeed:5.5*cat.speed,
    handling:cat.handling,
    emoji:cat.emoji, color:cat.color,
    progress:0.001, lap:1, finished:false,
    isPlayer:true, place:1
  };
  cpus=[];
  const others=CATS.filter((_,i)=>i!==selectedCat).slice(0,3);
  others.forEach((c,i)=>{
    cpus.push({
      x:TRACK_POINTS[0].x+(i-1)*30, y:TRACK_POINTS[0].y-40+(i+1)*30,
      vx:0, vy:0, angle:0,
      speed:0, maxSpeed:4.5+Math.random()*1.5,
      handling:0.6+Math.random()*0.3,
      emoji:c.emoji, color:c.color,
      progress:0.001-(i+1)*0.01, lap:1, finished:false,
      isPlayer:false,
      aiTarget:Math.random()*0.01,
    });
  });
  lap=1;
}

function updatePlayer(W,H){
  const cat=CATS[selectedCat];
  if(keys.gas) player.speed=Math.min(player.speed+0.18,player.maxSpeed);
  else if(keys.brake) player.speed=Math.max(player.speed-0.3,0);
  else player.speed=Math.max(player.speed-0.07,0);

  if(keys.left) player.angle-=0.045*player.handling*(player.speed/player.maxSpeed+0.3);
  if(keys.right) player.angle+=0.045*player.handling*(player.speed/player.maxSpeed+0.3);

  player.vx=Math.cos(player.angle)*player.speed;
  player.vy=Math.sin(player.angle)*player.speed;

  // find nearest track t
  let bestT=player.progress, bestD=9999;
  for(let i=-3;i<=3;i++){
    const t=((player.progress+i/NUM_TRACK_PTS)+1)%1;
    const d=distToTrack(player.x,player.y,t);
    if(d<bestD){bestD=d;bestT=t;}
  }

  // off track friction
  if(bestD>TRACK_W*0.9){
    player.speed*=0.92;
    player.vx*=0.92; player.vy*=0.92;
  }

  player.x+=player.vx;
  player.y+=player.vy;

  // update progress
  const newT=bestT;
  const prevProgress=player.progress;
  // check if we moved forward
  const diff=(newT-prevProgress+1)%1;
  if(diff<0.5) player.progress=(prevProgress+Math.min(diff,0.005)+1)%1;

  // lap detection
  if(prevProgress>0.95 && player.progress<0.05){
    player.lap++;
    if(player.lap>3){
      player.finished=true;
      player.progress=1;
    } else {
      showLapIndicator('LAP '+player.lap+'!');
    }
  }
}

function updateCPU(cpu){
  const targetT=(cpu.progress+0.015)%1;
  const target=getTrackPoint(targetT);
  const dx=target.x-cpu.x, dy=target.y-cpu.y;
  const desiredAngle=Math.atan2(dy,dx);
  let da=desiredAngle-cpu.angle;
  while(da>Math.PI)da-=Math.PI*2;
  while(da<-Math.PI)da+=Math.PI*2;
  cpu.angle+=da*0.08*cpu.handling;
  cpu.speed=Math.min(cpu.speed+0.12,cpu.maxSpeed*(0.85+Math.random()*0.15));
  cpu.vx=Math.cos(cpu.angle)*cpu.speed;
  cpu.vy=Math.sin(cpu.angle)*cpu.speed;
  cpu.x+=cpu.vx; cpu.y+=cpu.vy;
  const prev=cpu.progress;
  cpu.progress=(cpu.progress+cpu.speed*0.0008)%1;
  if(prev>0.95&&cpu.progress<0.05){
    cpu.lap++;
    if(cpu.lap>3) cpu.finished=true;
  }
}

function calcPlaces(){
  const all=[player,...cpus];
  all.forEach(r=>{
    r.totalProgress=(r.lap-1)+r.progress;
  });
  all.sort((a,b)=>b.totalProgress-a.totalProgress);
  all.forEach((r,i)=>r.place=i+1);
}

function showLapIndicator(txt){
  const el=document.getElementById('lap-indicator');
  el.textContent=txt;
  el.classList.add('show');
  clearTimeout(lapIndicatorTimer);
  lapIndicatorTimer=setTimeout(()=>el.classList.remove('show'),1500);
}

// DRAW
function drawGame(ctx,W,H,camX,camY){
  // sky
  ctx.fillStyle='#87CEEB';
  ctx.fillRect(0,0,W,H);

  // grass
  ctx.fillStyle='#3a7d1e';
  ctx.fillRect(0,0,W,H);

  // draw checkered pattern on grass
  ctx.fillStyle='#349118';
  for(let gx=0;gx<W;gx+=40){
    for(let gy=0;gy<H;gy+=40){
      if((Math.floor(gx/40)+Math.floor(gy/40))%2===0)
        ctx.fillRect(gx-camX%40,gy-camY%40,40,40);
    }
  }

  // draw track
  ctx.save();
  ctx.translate(-camX,-camY);

  // track shadow/base
  ctx.strokeStyle='#555';
  ctx.lineWidth=TRACK_W*2+8;
  ctx.lineCap='round';
  ctx.lineJoin='round';
  ctx.beginPath();
  TRACK_POINTS.forEach((p,i)=>{
    i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y);
  });
  ctx.closePath();
  ctx.stroke();

  // road
  ctx.strokeStyle='#555';
  ctx.lineWidth=TRACK_W*2;
  ctx.beginPath();
  TRACK_POINTS.forEach((p,i)=>{
    i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y);
  });
  ctx.closePath();
  ctx.stroke();

  // lane markings
  ctx.strokeStyle='rgba(255,255,255,0.25)';
  ctx.lineWidth=3;
  ctx.setLineDash([30,20]);
  ctx.beginPath();
  TRACK_POINTS.forEach((p,i)=>{
    i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y);
  });
  ctx.closePath();
  ctx.stroke();
  ctx.setLineDash([]);

  // start/finish line
  const sp=TRACK_POINTS[0];
  const dir=getTrackDir(0);
  ctx.save();
  ctx.translate(sp.x,sp.y);
  ctx.rotate(Math.atan2(dir.dy,dir.dx)+Math.PI/2);
  for(let ci=0;ci<8;ci++){
    ctx.fillStyle=ci%2===0?'white':'black';
    ctx.fillRect(-TRACK_W+ci*TRACK_W/4,-8,TRACK_W/4,16);
  }
  ctx.restore();

  // draw trees/decorations
  const decos=[
    {x:W*0.5,y:H*0.5,t:'🌳'},{x:W*0.2,y:H*0.3,t:'🌵'},{x:W*0.8,y:H*0.3,t:'🌴'},
    {x:W*0.15,y:H*0.7,t:'🦆'},{x:W*0.85,y:H*0.7,t:'🐸'},{x:W*0.5,y:H*0.18,t:'🎪'},
    {x:W*0.5,y:H*0.82,t:'🏟️'},{x:W*0.3,y:H*0.5,t:'🍄'},{x:W*0.7,y:H*0.5,t:'💎'},
  ];
  ctx.font='28px serif';
  ctx.textAlign='center';
  ctx.textBaseline='middle';
  decos.forEach(d=>ctx.fillText(d.t,d.x,d.y));

  // draw CPUs
  cpus.forEach(cpu=>{
    ctx.save();
    ctx.translate(cpu.x,cpu.y);
    ctx.rotate(cpu.angle+Math.PI/2);
    ctx.font='32px serif';
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillText(cpu.emoji,0,0);
    ctx.restore();
  });

  // draw player
  ctx.save();
  ctx.translate(player.x,player.y);
  ctx.rotate(player.angle+Math.PI/2);
  // shadow
  ctx.fillStyle='rgba(0,0,0,0.25)';
  ctx.beginPath();
  ctx.ellipse(4,4,18,12,0,0,Math.PI*2);
  ctx.fill();
  ctx.font='38px serif';
  ctx.textAlign='center';
  ctx.textBaseline='middle';
  ctx.fillText(player.emoji,0,0);
  ctx.restore();

  ctx.restore();
}

function startRace(){
  hideAll();
  document.getElementById('game-screen').classList.remove('hidden');
  const canvas=document.getElementById('raceCanvas');
  const W=window.innerWidth, H=window.innerHeight;
  canvas.width=W; canvas.height=H;
  const ctx=canvas.getContext('2d');
  generateTrack(W,H);
  initRacers(W,H);
  keys={gas:false,brake:false,left:false,right:false};

  // keyboard support
  document.onkeydown=e=>{
    if(e.key==='ArrowUp'||e.key==='w')keys.gas=true;
    if(e.key==='ArrowDown'||e.key==='s')keys.brake=true;
    if(e.key==='ArrowLeft'||e.key==='a')keys.left=true;
    if(e.key==='ArrowRight'||e.key==='d')keys.right=true;
  };
  document.onkeyup=e=>{
    if(e.key==='ArrowUp'||e.key==='w')keys.gas=false;
    if(e.key==='ArrowDown'||e.key==='s')keys.brake=false;
    if(e.key==='ArrowLeft'||e.key==='a')keys.left=false;
    if(e.key==='ArrowRight'||e.key==='d')keys.right=false;
  };

  if(gameLoop) cancelAnimationFrame(gameLoop);

  function frame(){
    if(!player.finished){
      updatePlayer(W,H);
      cpus.forEach(updateCPU);
      calcPlaces();
    }

    // camera follows player
    const camX=player.x-W/2;
    const camY=player.y-H/2;

    drawGame(ctx,W,H,camX,camY);

    // HUD
    document.getElementById('hud-lap').textContent=Math.min(player.lap,3)+'/3';
    document.getElementById('hud-place').textContent=PLACE_NAMES[player.place-1]||'4th';
    document.getElementById('hud-speed').textContent=Math.round(player.speed*20);

    if(player.finished){
      showResults();
      return;
    }
    // all cpus done and player still going? keep going
    gameLoop=requestAnimationFrame(frame);
  }
  gameLoop=requestAnimationFrame(frame);
}

function showResults(){
  if(gameLoop){cancelAnimationFrame(gameLoop);gameLoop=null;}
  hideAll();
  document.getElementById('result-screen').classList.remove('hidden');
  const place=player.place;
  const quip=QUIPS[place-1]||"you tried!";
  document.getElementById('result-sub').textContent=quip;
  document.getElementById('your-place').innerHTML=`You finished <span>${PLACE_NAMES[place-1]}</span>!`;

  // build podium from all racers
  const all=[player,...cpus].sort((a,b)=>a.place-b.place);
  const podium=document.getElementById('podium');
  const order=[all[1],all[0],all[2]]; // 2nd, 1st, 3rd
  const heights=['p2-block','p1-block','p3-block'];
  const nums=['2','1','3'];
  podium.innerHTML=order.map((r,i)=>`
    <div class="podium-place">
      <div class="podium-cat">${r?r.emoji:'?'}</div>
      <div class="podium-block ${heights[i]}">${nums[i]}</div>
    </div>`).join('');
}
</script>
